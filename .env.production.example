# ==========================================
# MINERAL GALLERY - PRODUCTION ENVIRONMENT
# ==========================================
# This is a template for production environment variables
# Copy to .env.production and fill in your production values
# NEVER commit .env.production to git!

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL Required)
# ==========================================
# Production database URL (must be PostgreSQL)
# Format: postgresql://user:password@hostname:port/database
# Examples:
# - Railway: postgresql://user:pass@hostname.railway.internal:5432/railway
# - Vercel Postgres: postgresql://user:pass@ep-xxxxx.us-east-1.postgres.vercel-storage.com:5432/verceldb
# - Supabase: postgresql://user:pass@xxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@hostname:5432/mineralsdb"

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# IMPORTANT: Generate a strong JWT secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters
JWT_SECRET="your-strong-production-jwt-secret-min-32-chars-xxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# STRIPE PAYMENT PROCESSING
# ==========================================
# Production Stripe keys (starts with sk_live_ and pk_live_)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# EMAIL SERVICE (SMTP)
# ==========================================
# Production SMTP configuration
# Recommended: Use a transactional email service
# Options: Gmail (with app password), SendGrid, Mailgun, AWS SES, etc.

# Gmail Setup (with App Password):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-production-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="noreply@yourdomain.com"

# Or SendGrid:
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
# SMTP_FROM="noreply@yourdomain.com"

# ==========================================
# FILE UPLOAD (Vercel Blob Storage)
# ==========================================
# Production Vercel Blob token for image uploads
# Get from: https://vercel.com/dashboard/store/blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Your production domain
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Must be "production" for optimizations
NODE_ENV="production"

# ==========================================
# SUPABASE (Optional - if using additional features)
# ==========================================
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# ==========================================
# OPTIONAL: MONITORING & LOGGING
# ==========================================
# Enable error tracking (e.g., Sentry)
# SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# ==========================================
# PRODUCTION CHECKLIST
# ==========================================
# ✅ Database URL is PostgreSQL (not SQLite)
# ✅ JWT_SECRET is strong (32+ random characters)
# ✅ All Stripe keys are from "live" environment
# ✅ SMTP credentials are correct
# ✅ APP_URL uses https:// and correct domain
# ✅ NODE_ENV is set to "production"
# ✅ All sensitive values are filled in
# ✅ .env.production is in .gitignore (NEVER commit!)
