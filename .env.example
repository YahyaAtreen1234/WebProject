# ==========================================
# MINERAL GALLERY - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.local and fill in your values
# For production, use .env.production.example as a reference

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# For Development (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# For Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:port/mineralsdb"
# Examples:
# - Railway: postgresql://user:password@hostname:port/database
# - Vercel Postgres: postgresql://user:password@host/database
# - Supabase: postgresql://user:password@host/database?schema=public

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# JWT Secret for signing tokens (change this in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Admin credentials (for initial setup in development)
ADMIN_EMAIL="admin@minerals.local"
ADMIN_PASSWORD="admin123"

# ==========================================
# STRIPE PAYMENT PROCESSING
# ==========================================
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_test_xxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"

# ==========================================
# EMAIL SERVICE (SMTP)
# ==========================================
# Gmail setup: https://support.google.com/accounts/answer/185833
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@stonesland.com"

# ==========================================
# FILE UPLOAD (Vercel Blob)
# ==========================================
# Get token from: https://vercel.com/dashboard/projects
# Only needed if using Vercel deployment
# BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxx"

# ==========================================
# SUPABASE (Optional)
# ==========================================
# If using Supabase for additional features
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Frontend URL (used in emails, redirects, etc)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# Optional: Enable detailed logging in development
# DEBUG="*"
