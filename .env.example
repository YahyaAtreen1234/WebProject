# Database
# PostgreSQL is required — prisma/schema.prisma declares provider = "postgresql",
# and Prisma does not accept the provider from an env var. Use a hosted database
# (Vercel Postgres / Neon / Supabase) for both local development and production.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Stripe Payment
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="noreply@stonesland.com"
SMTP_SECURE="false"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File Upload (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: Google reCAPTCHA v2 checkbox on the sign in / register panel.
# Leave both unset to hide the widget and skip verification entirely.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Optional: Supabase (if using for storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
